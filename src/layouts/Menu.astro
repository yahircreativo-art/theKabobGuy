---
import Card from '../components/Card.astro';
import CardPrice from '../components/CardPrice.astro';

import plate1 from '../assets/image1.webp';
import plate2 from '../assets/image2.webp';
import plate3 from '../assets/image3.webp';
import plate4 from '../assets/image4.webp';
import plate5 from '../assets/image5.webp';
import plate6 from '../assets/image6.webp';
---
<section class="flex flex-col bg-zinc-950 justify-center py-32">
    <div class="container flex flex-col w-11/12 max-w-6xl gap-8 mx-auto">
        <div class="flex flex-col gap-4">
            <h2 class="text-center text-3xl font-medium text-zinc-50">The Fire-Forged Collection</h2>
            <p class="text-center text-zinc-300">Signatura skewers crafted for the discerning palate.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <Card title="HUMUS AND PITA CHIPS" price='$10.95' description="Hummus (minced grabanzo beans, garlic, tahini paste, lemon juice, olvie oil) with side of freshly fried and seasoned chips (made with avocado oil)." backgroundImage={{ src: plate1.src, alt: 'plate 1'}} />
    
            <Card title="GREEK SALAD" price='$14.95' description="Romaine lettuce, tomatoes, cucumbers, red onions, bell peppers, feta cheese, lamata olives with house dressing and a protein: 3 piece chicken breast $6 / 3 piece beef tendertion $10." backgroundImage={{src: plate2.src, alt: 'plate 2'}} />
    
            <Card title="BEEF LULE PLATE" price='$19.95' description="2 skewers of ground sirloin seasoned grilled to order / rice pilaf / house salad with lettuce, tomatoes, cucumbers, red onions and house dressing / hummus / pita bread." backgroundImage={{ src: plate3.src, alt: 'plate 3'}} />
    
            <Card title="CHICKEN BREAST PLATE" price='$19.95' description="5 pieces of chicken breast seasoned with fresh herbs / rice pilaf / house salad with lettuce, tomatoes, cucumbers, red onions and house dressing / hummus / pita bread." backgroundImage={{ src: plate4.src, alt: 'plate 4'}} />

            <Card title="CHICKEN LULE PLATE" price='$17.95' description="2 skewers of ground chicken seasoned / rice pilaf / house salad with lettuce, tomatoes, cucumbers, red onions and house dressing / hummus / pita bread." backgroundImage={{ src: plate5.src, alt: 'plate 5'}} />

            <Card title="BEEF KABOB PLATE" price='$24.95' description="5 pieces of beef tenderloin seasoned grilled to order / rice pilaf / house salad with lettuce, tomatoes, cucumbers, red onions and house dressing / hummus / pita bread." backgroundImage={{ src: plate6.src, alt: 'plate 6'}} />
        </div>     
    </div>
</section>