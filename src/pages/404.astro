---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

---

<Layout title="404 - The Kabob Guy" description="The page you are looking for could not be found." canonical="/404">
  <main class="relative min-h-[calc(100vh-160px)] overflow-hidden bg-black text-zinc-50">
    
    <div class="absolute inset-0 bg-gradient-to-b from-black via-black/80 to-black"></div>

    <div class="relative z-10 mx-auto flex min-h-[calc(100vh-160px)] max-w-6xl flex-col items-center justify-center gap-6 px-6 py-20 text-center">
      <p class="text-sm uppercase tracking-[0.5rem] text-amber-300">404 error</p>

      <div class="flex items-end gap-3 text-amber-300">
        <span class="text-7xl font-black tracking-tight sm:text-8xl md:text-9xl">4</span>
        <span class="text-7xl font-black tracking-tight sm:text-8xl md:text-9xl text-white">0</span>
        <span class="text-7xl font-black tracking-tight sm:text-8xl md:text-9xl">4</span>
      </div>

      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-5xl">
        Page not found
      </h1>

      <p class="max-w-xl text-base text-zinc-300 md:text-lg">
        The page you are looking for may have moved, been removed, or never existed.
        Let’s take you back to the table.
      </p>

      <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
        <Button label="Go to Home" href="/" />
        <a
          href="/menu"
          class="inline-flex items-center justify-center border border-zinc-700 bg-zinc-900/60 px-8 py-2.5 text-sm font-medium text-zinc-50 transition-colors duration-300 hover:border-amber-300 hover:text-amber-300"
        >
          View menu
        </a>
      </div>
    </div>
  </main>
</Layout>
