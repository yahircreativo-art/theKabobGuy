---
import Layout from '../layouts/Layout.astro'
import Hero from '../layouts/Hero.astro';
import About from '../layouts/About.astro';
import Menu from '../layouts/Menu.astro';
import Prices from '../layouts/Prices.astro';
import  Button  from '../components/Button.astro';
const schema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": "the kabob guy",
  "url": "#",
  "logo": "#",
  "image": "#",
  "description": "Mediterranean grill offering kabobs, fire-roasted plates, and Persian-inspired flavors in a modern dining experience.",
  "telephone": "+1-555-578-5490",
  "email": "#",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1234 Fire Forged Way",
    "addressLocality": "Cuisine District",
    "addressRegion": "NY",
    "postalCode": "10012",
    "addressCountry": "US"
  },
  "servesCuisine": "Mediterranean",
  "priceRange": "$$"
};
---

<Layout title="Maintenance | The kabob guy" description="The kabob guy is currently under maintenance." canonical="/" schema={schema}>
  <main class="relative min-h-[calc(100vh-160px)] overflow-hidden bg-black text-zinc-50">
    <div class="absolute inset-0 bg-gradient-to-b from-black via-black/80 to-black"></div>

    <div class="relative z-10 mx-auto flex min-h-[calc(100vh-160px)] max-w-6xl flex-col items-center justify-center gap-6 px-6 py-20 text-center">
      <p class="text-sm uppercase tracking-[0.5rem] text-amber-300">Maintenance</p>

      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-5xl">
        We’ll be back soon
      </h1>

      <p class="max-w-xl text-base text-zinc-300 md:text-lg">
        We are currently updating our experience and preparing something special for you.
        Please check back soon.
      </p>
    </div>
  </main>
</Layout>

