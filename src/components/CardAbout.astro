---
import Button from '../components/Button.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  button?: {
    label: string;
    href: string;
    };
    image?: {
      src: string;
      alt: string;
    }
    imagePosition?: 'top' | 'bottom';
}
const {
    title,
    description,
    subtitle,
    button,
    image,
    imagePosition = 'top'
} = Astro.props;
---
    <div class="container w-11/12 max-w-6xl grid grid-cols-1 grid-rows-auto md:grid-rows-1 md:grid-cols-5 gap-8 my-auto auto-rows-auto">
    {imagePosition === 'top' && image && (
        <div class="sm:col-span-2">
            <img
                src={image.src}
                alt={image.alt}
                class="w-full h-auto"/>
        </div>
    )}
        <div class="sm:col-span-3 flex flex-col gap-4 justify-center">
            <h2 class="text-4xl sm:text-5xl font-semibold text-white">{title}</h2>
            {subtitle && <h3 class="text-amber-300 underline">{subtitle}</h3>}
            <p class="text-zinc-200">{description}</p>
            
        </div>
    {imagePosition === 'bottom' && image && (
        <div class="sm:col-span-2">
            <img
                src={image.src}
                alt={image.alt}
                class="w-full h-auto"/>
        </div>
    )}
    </div>