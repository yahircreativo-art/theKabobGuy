---
import backgroundImage from '../assets/backgroundFooter.webp';
import logo from '../assets/logo.webp'
---

<section class="bg-black text-zinc-300 py-8">
    <div class="container w-11/12 max-w-6xl mx-auto gap-4 flex flex-col justify-center">
        <img src={logo.src} alt="The Kabob Guy Logo" class="h-auto w-auto max-w-60 mx-auto" />
        <span class="font-semibold text-lg">CONTACT</span>
        
        
        <div class="flex mt-2 gap-2">
            <span>Email:</span>
            <a href="tel:+16612997755" class="text-amber-300 font-semibold underline hover:text-amber-400">+1 (661) 299-7755</a>
        </div>

        <div class="flex mt-2 gap-2">
            <span>Email:</span>
            <a href="mailto:info@thekabobguy.com" class="text-amber-300 font-semibold hover:text-amber-400 underline">info@thekabobguy.com</a>
        </div>
        
        <div class="flex mt-2 gap-2">
            <span>Instagram:</span>
            
            <a href="#" target="_blank" rel="noopener noreferrer" class="font-semibold text-amber-300 hover:text-amber-400 underline transition-colors" aria-label="Instagram">@thekabobguy
            </a>
        </div>
    </div>
</section>
<section style={`background-image: url(${backgroundImage.src});`} class="bg-cover bg-center bg-no-repeat h-50 border-t border-zinc-900">
    <div class="container flex w-11/12 mx-auto pt-16 justify-center">
        <p class="text-center text-white">&copy; {new Date().getFullYear()} The Kabob Guy. All rights reserved.</p>
    </div>
</section>