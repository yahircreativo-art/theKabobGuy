---
import Button from './Button.astro';
import logoWeb from '../assets/logo.webp'

const pathname = Astro.url.pathname;

const links = [
    { label: 'Home', href: '/' },
    { label: 'About Us', href: '/about' },
    { label: 'Menu', href: '/menu' },
    { label: 'Gallery', href: '/gallery' },
];

function isActive(href: string): boolean {
    if (href === '/') return pathname === '/';
    return pathname.startsWith(href);
}
---

<header class="fixed w-full top-0 z-50 bg-black/60 backdrop-blur-sm">
    <nav>
        <input id="nav-toggle" type="checkbox" class="peer sr-only" />

        <div class="container max-w-6xl mx-auto flex items-center justify-between py-2 w-11/12">
            <a href="/" class="flex items-center">
                <img src={logoWeb.src} alt="The Kabob Guy Logo" class="h-20 sm:h-24 md:h-28 w-auto" />
            </a>

            <div class="flex items-center gap-4 md:hidden">
                <label for="nav-toggle" class="inline-flex h-10 w-10 flex-col items-center justify-center space-y-1.5 cursor-pointer text-zinc-100 transition hover:border-amber-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300">
                    <span class="block h-0.5 w-6 bg-zinc-100 transition-transform duration-200 peer-checked:translate-y-1.5 peer-checked:rotate-45"></span>
                    <span class="block h-0.5 w-6 bg-zinc-100 transition-opacity duration-200 peer-checked:opacity-0"></span>
                    <span class="block h-0.5 w-6 bg-zinc-100 transition-transform duration-200 peer-checked:-translate-y-1.5 peer-checked:-rotate-45"></span>
                </label>
            </div>

            <ul class="hidden items-center gap-4 md:flex">
                {links.map(({ label, href }) => (
                    <li>
                        <a
                            href={href}
                            class:list={[
                                'hover:text-amber-300 transition-colors',
                                isActive(href) ? 'text-amber-300 font-medium' : 'text-zinc-50',
                            ]}
                        >
                            {label}
                        </a>
                    </li>
                ))}
                <Button label="Contact" href="/contact" />
            </ul>
        </div>

        <div class="absolute inset-x-0 top-full z-40 block overflow-hidden max-h-0 opacity-0 scale-y-95 bg-black/60 px-4 py-0 transition-[max-height,opacity,transform] duration-300 ease-out md:hidden peer-checked:max-h-[20rem] peer-checked:opacity-100 peer-checked:scale-y-100 peer-checked:py-4">
            <ul class="flex flex-col gap-3">
                {links.map(({ label, href }) => (
                    <li>
                        <a
                            href={href}
                            class:list={[
                                'block rounded-lg px-3 py-2 transition-colors',
                                isActive(href)
                                    ? 'text-amber-300 bg-zinc-950/40 font-medium'
                                    : 'text-zinc-50 hover:bg-zinc-950/40 hover:text-amber-300',
                            ]}
                        >
                            {label}
                        </a>
                    </li>
                ))}
                <li>
                    <a href="tel:+16612997755" class="block rounded-lg px-3 py-2 text-zinc-50 hover:bg-zinc-950/40 hover:text-amber-300">Contact</a>
                </li>
            </ul>
        </div>
    </nav>
</header>
