---
import logo from '../assets/logo.webp'
---
<section class="flex bg-black justify-center">
    <div class="container w-11/12 max-w-6xl flex items-center gap-8 mx-auto py-32">

        <div class="w-11/12 align-center mx-auto md:w-auto flex flex-col justify-center text-zinc-200">
            <img src={logo.src} alt="The Kabob Guy Logo" class="h-auto w-auto max-h-96 mx-auto" />
        </div>
        
    </div>
</section>