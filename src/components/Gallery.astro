---
import Image from '../components/Image.astro'
import chefs from '../assets/chefs.jpeg'
import greekSalad from '../assets/greek-salad.webp'
import beefLule from '../assets/beef-lule.webp'
import chickenBreast from '../assets/chicken-breast.webp'
import chickenLule from '../assets/chicken-lule.webp'
import background from '../assets/background.webp'

import chef from '../assets/chef.webp'
import chef2 from '../assets/chef2.webp'
---
<section class="flex justify-center min-h-screen">
    <div class="container max-w-6xl py-32 gap-8 w-11/12 ">
        <div class="flex flex-col gap-4 text-center">
            <span class="text-md font-medium underline underline-offset-10 text-amber-300">GALLERY</span>
            <h2 class="text-white text-3xl font-medium">SOME EXPERIENCES</h2>
            <div class="grid sm:grid-cols-3 gap-4 sm:grid-rows-3 auto-rows-fr">
                <Image image={{src:background.src, alt:'Restaurant background'}} class:list={'sm:col-start-1 sm:col-end-2 sm:row-start-1 sm:row-end-2 h-full object-cover'}/>
                <Image image={{src:chef.src, alt:'Chef Pat Minassian'}} class:list={'sm:col-start-2 sm:col-end-4 h-full object-cover'}/>
                <Image image={{src:beefLule.src, alt:'Beef lule plate'}} class:list={'sm:col-start-1 sm:col-end-2 sm:row-start-2 sm:row-end-3 h-full object-cover'}/>
                <Image image={{src:chef2.src, alt:'Chef Pat Minassian'}} class:list={'sm:col-start-2 sm:col-end-3 sm:row-start-2 sm:row-end-3 h-full object-cover'}/>
                <Image image={{src:chickenLule.src, alt:'Chicken lule plate'}} class:list={'sm:col-start-3 sm:col-end-4 sm:row-start-2 sm:row-end-4 h-full object-cover'}/>
                <Image image={{src:greekSalad.src, alt:'Greek salad'}} class:list={'sm:col-start-1 sm:col-end-3 sm:row-start-3 sm:row-end-4 h-full object-cover'}/>
            </div>
        </div>
    </div>
</section>
